[
{
"t": 0.0,
"end": 3.3,
"text": "This nineteen-seat airplane flies on batteries."
},
{
"t": 3.58,
"end": 5.22,
"text": "No jet fuel at all!"
},
{
"t": 5.96,
"end": 8.37,
"text": "It's called the CE-25A,"
},
{
"t": 8.64,
"end": 10.48,
"text": "from Chinese planemaker COMAC."
},
{
"t": 10.97,
"end": 12.197,
"text": "On November fourteenth,"
},
{
"t": 12.197,
"end": 13.475,
"text": "it made its first flight"
},
{
"t": 13.475,
"end": 14.6,
"text": "with people on board."
},
{
"t": 15.34,
"end": 16.748,
"text": "Two pilots and a flight"
},
{
"t": 16.748,
"end": 18.391,
"text": "test engineer took off from"
},
{
"t": 18.391,
"end": 20.21,
"text": "Binzhou, in Shandong province."
},
{
"t": 20.96,
"end": 22.229,
"text": "They stayed in the air"
},
{
"t": 22.229,
"end": 23.994,
"text": "for about seventeen minutes and"
},
{
"t": 23.994,
"end": 25.76,
"text": "covered about sixty kilometers."
},
{
"t": 26.56,
"end": 28.149,
"text": "Instead of jet engines,"
},
{
"t": 28.149,
"end": 29.87,
"text": "it has ten electric fans,"
},
{
"t": 30.03,
"end": 31.28,
"text": "five on each wing."
},
{
"t": 31.74,
"end": 33.546,
"text": "Somebody's gonna need a really"
},
{
"t": 33.546,
"end": 34.77,
"text": "long charging cable!"
},
{
"t": 35.58,
"end": 37.104,
"text": "Its cruising speed is about"
},
{
"t": 37.104,
"end": 39.01,
"text": "three hundred kilometers per hour."
},
{
"t": 39.84,
"end": 41.191,
"text": "It's about ten tonnes,"
},
{
"t": 41.191,
"end": 42.66,
"text": "and it's designed to fly"
},
{
"t": 42.66,
"end": 44.48,
"text": "up to four hundred kilometers,"
},
{
"t": 44.48,
"end": 46.36,
"text": "around two hundred fifty miles,"
},
{
"t": 46.36,
"end": 47.3,
"text": "between cities."
},
{
"t": 48.07,
"end": 48.817,
"text": "Before this,"
},
{
"t": 48.817,
"end": 50.484,
"text": "it had already made nineteen"
},
{
"t": 50.484,
"end": 52.38,
"text": "test flights with nobody aboard."
},
{
"t": 52.94,
"end": 53.51,
"text": "Next up:"
},
{
"t": 53.88,
"end": 55.48,
"text": "earning its safety certificate,"
},
{
"t": 55.8,
"end": 57.825,
"text": "and China's aviation regulator has"
},
{
"t": 57.825,
"end": 59.33,
"text": "accepted its application."
},
{
"t": 60.11,
"end": 61.914,
"text": "COMAC says the plane behaved"
},
{
"t": 61.914,
"end": 63.78,
"text": "normally, and all the results"
},
{
"t": 63.78,
"end": 64.9,
"text": "met expectations."
},
{
"t": 65.74,
"end": 67.167,
"text": "Follow for a little good"
},
{
"t": 67.167,
"end": 68.08,
"text": "news every day."
}
]